@inject IMediator Mediator;

<h1>Club Stats For Year</h1>

@if (!ClubStatsForYears.Any() && !IsInvalidClubStatsForYear)
{
    <p><em>Loading...</em></p>
}
else if (IsInvalidClubStatsForYear)
{
    <ErrorMessage Error="@ErrorMessage" />
}
else
{
    <FilterComponents @bind-Cyclist="@SearchText"
                      Cyclists="Cyclists"
                      IsSmall="IsSmall" />
    
    <MudTable T="StravaClubStatsForYear"
                  Items="ClubStatsForYears" 
                  Filter="quickFilter"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Breakpoint="Breakpoint.Xs">
        <HeaderContent>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.Cyclist)">
                    Cyclist
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.Rides)">
                    Rides
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.Time)">
                    Time
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.Distance)">
                    Distance (KMs)
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.ElevationGain)">
                    Elevation Gain (metres)
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.DistanceTarget)">
                    Distance Target (KMs)
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.DistanceLeftToDo)">
                    Distance Left to Do (KMs)
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.DistanceTargetForCurrentWeek)">
                    Distance Target for Current Week (KMs)
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.AverageDistanceToDoPerWeek)">
                    Average Distance To Do Per Week (KMs)
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.AverageDistanceDonePerWeek)">
                    Average Distance Done Per Week (KMs)
                </MudTableSortLabel>
            </MudTd>
            <MudTd>
                <MudTableSortLabel SortBy="new Func<StravaClubStatsForYear, object>(item => item.AverageDistanceLeftToDoPerWeek)">
                    Average Distance Left To Do Per Week (KMs)
                </MudTableSortLabel>
            </MudTd>
        </HeaderContent>
         <RowTemplate Context="Item">
            <MudTd>@Item.Cyclist</MudTd>
            <MudTd>@Item.Rides</MudTd>
            <MudTd>@Item.Time</MudTd>
            <MudTd Class="x => ConvertTo2DecimalPlaces(x.Distance)">@ConvertTo2DecimalPlaces(Item.Distance)</MudTd>
            <MudTd>@ConvertTo2DecimalPlaces(Item.ElevationGain)</MudTd>
            <MudTd>@ConvertTo2DecimalPlaces(Item.DistanceTarget)</MudTd>
            <MudTd>@ConvertTo2DecimalPlaces(Item.DistanceLeftToDo)</MudTd>
            <MudTd>@ConvertTo2DecimalPlaces(Item.DistanceTargetForCurrentWeek)</MudTd>
            <MudTd>@ConvertTo2DecimalPlaces(Item.AverageDistanceToDoPerWeek)</MudTd>
            <MudTd>@ConvertTo2DecimalPlaces(Item.AverageDistanceDonePerWeek)</MudTd>
            <MudTd>@ConvertTo2DecimalPlaces(Item.AverageDistanceLeftToDoPerWeek)</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No club stats</MudText>
        </NoRecordsContent>
    </MudTable>
}

<MediaQuery Media="@BlazorPro.BlazorSize.Breakpoints.SmallDown" @bind-Matches="IsSmall" />